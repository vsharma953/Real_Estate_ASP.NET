<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="Real_Estate.Site" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>realEstate International Architectural Residences</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' stroke='%23a3875a' stroke-width='2' fill='none'><path d='M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z'/><polyline points='9 22 9 12 15 12 15 22'/></svg>">
    <link rel="stylesheet" href="~/css/style.css" runat="server" />

    <asp:ContentPlaceHolder
        ID="HeadContent"
        runat="server">
    </asp:ContentPlaceHolder>

    <style>
        /* ====================================================
           NAVBAR: identical font everywhere + zero underlines,
           including any .active state or ::before/::after
           pseudo-element underline animation from style.css
        ==================================================== */
        .nav-menu a,
        .nav-menu a.nav-link,
        .nav-menu a.nav-link.active,
        .nav-menu button.nav-link,
        .nav-menu .account-trigger,
        .nav-menu .account-trigger.active {
            font-family: inherit;
            font-size: 0.8rem;
            font-weight: 600;
            letter-spacing: 0.6px;
            text-transform: uppercase;
            color: #4a4a4a;
            text-decoration: none;
            border: none;
            border-bottom: none;
            box-shadow: none;
            outline: none;
            line-height: 1;
            background: none;
            padding: 0;
            margin: 0;
            position: relative;
        }

            .nav-menu a:hover,
            .nav-menu a:focus,
            .nav-menu a:active,
            .nav-menu a.nav-link:hover,
            .nav-menu a.nav-link:focus,
            .nav-menu a.nav-link:active,
            .nav-menu a.nav-link.active,
            .nav-menu button.nav-link:hover,
            .nav-menu button.nav-link:focus,
            .nav-menu .account-trigger:hover,
            .nav-menu .account-trigger:focus,
            .nav-menu .account-trigger.active,
            .nav-menu .account-trigger[aria-expanded="true"] {
                color: var(--accent, #a3875a);
                text-decoration: none !important;
                border: none !important;
                border-bottom: none !important;
                box-shadow: none !important;
                outline: none !important;
            }

            /* Kill any ::before/::after underline animation
               (a very common pattern: an absolutely-positioned
               bar that scales in on hover/active) */
            .nav-menu a::before,
            .nav-menu a::after,
            .nav-menu a.nav-link::before,
            .nav-menu a.nav-link::after,
            .nav-menu button.nav-link::before,
            .nav-menu button.nav-link::after,
            .nav-menu .account-trigger::before,
            .nav-menu .account-trigger::after {
                display: none !important;
                content: none !important;
            }

        /* Account dropdown items follow the same base font,
           but stay normal-case and slightly larger since they
           sit in a popover, not the top nav bar */
        .account-dropdown-menu a,
        .account-dropdown-menu .logout-nav-button {
            font-family: inherit;
            text-transform: none;
            letter-spacing: 0;
            text-decoration: none;
            border: none;
            box-shadow: none;
            outline: none;
        }

            .account-dropdown-menu a::before,
            .account-dropdown-menu a::after,
            .account-dropdown-menu .logout-nav-button::before,
            .account-dropdown-menu .logout-nav-button::after {
                display: none !important;
                content: none !important;
            }

        .logout-nav-button {
            background: none;
            border: none;
            padding: 0;
            margin: 0;
            color: inherit;
            font-family: inherit;
            font-size: inherit;
            font-weight: inherit;
            cursor: pointer;
        }

            .logout-nav-button:hover {
                color: var(--accent);
            }

        /* ---------- Account dropdown ---------- */
        .account-nav-item {
            position: relative;
        }

        .account-trigger {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
        }

            .account-trigger .chevron {
                width: 11px;
                height: 11px;
                stroke: currentColor;
                transition: transform 0.18s ease;
            }

            .account-trigger[aria-expanded="true"] .chevron {
                transform: rotate(180deg);
            }

        .account-dropdown-menu {
            position: absolute;
            top: calc(100% + 14px);
            left: 50%;
            transform: translateX(-50%) translateY(-6px);
            min-width: 170px;
            background: #fff;
            border: 1px solid #ececec;
            border-radius: 10px;
            box-shadow: 0 14px 34px rgba(0, 0, 0, 0.12);
            padding: 8px;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: opacity 0.16s ease, transform 0.16s ease, visibility 0.16s;
            z-index: 60;
        }

            .account-dropdown-menu.open {
                opacity: 1;
                visibility: visible;
                pointer-events: auto;
                transform: translateX(-50%) translateY(0);
            }

        .account-dropdown-menu a,
        .account-dropdown-menu .logout-nav-button {
            display: flex;
            align-items: center;
            gap: 9px;
            width: 100%;
            padding: 10px 12px;
            border-radius: 7px;
            font-size: 0.85rem;
            font-weight: 600;
            text-align: left;
            color: #333;
        }

            .account-dropdown-menu a:hover {
                background: #f6f3ee;
                color: var(--accent, #a3875a);
            }

        .account-dropdown-menu .logout-nav-button {
            color: #b40000;
        }

            .account-dropdown-menu .logout-nav-button:hover {
                background: #fdf1f1;
                color: #8f0000;
            }

        .account-dropdown-menu .menu-divider {
            height: 1px;
            background: #ededed;
            margin: 6px 4px;
        }

        .account-dropdown-menu svg {
            width: 15px;
            height: 15px;
            flex-shrink: 0;
        }

        @media (max-width: 900px) {
            .account-dropdown-menu {
                position: static;
                transform: none;
                box-shadow: none;
                border: none;
                padding: 0 0 0 14px;
                display: none;
                min-width: 0;
            }

                .account-dropdown-menu.open {
                    display: block;
                }

            .account-trigger .chevron {
                display: none;
            }
        }
    </style>

</head>

<body>

    <form id="form1" runat="server">
        <div class="page-loader" id="page-loader">
            <div class="loader-spinner"></div>
        </div>
        <header>

            <div class="container nav-container">

                <a href="Default.aspx"
                    class="logo">real<span>Estate</span>

                </a>

                <nav class="nav-menu"
                    id="nav-menu">

                    <a href="Default.aspx"
                        class="nav-link">Home

                    </a>

                    <a href="Properties.aspx"
                        class="nav-link">Residences

                    </a>
                    <a href="EMICalculator.aspx"
                        class="nav-link">EMI Calculator

                    </a>

                    <a href="Services.aspx"
                        class="nav-link">Services

                    </a>


                    <a href="About.aspx"
                        class="nav-link">About Us

                    </a>

                    <a href="Contact.aspx"
                        class="nav-link">Contact Us

                    </a>

                    <asp:Panel
                        ID="pnlRegister"
                        runat="server"
                        CssClass="nav-item"
                        Style="display: inline;">

                        <a href="LoginRegister.aspx"
                            class="nav-link">Register

                        </a>

                    </asp:Panel>

                    <asp:Panel
                        ID="pnlAccount"
                        runat="server"
                        CssClass="nav-item account-nav-item"
                        Visible="false"
                        Style="display: inline-block;">

                        <button
                            type="button"
                            id="accountTrigger"
                            class="nav-link account-trigger"
                            aria-haspopup="true"
                            aria-expanded="false">

                            Account

                            <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>

                        </button>

                        <div class="account-dropdown-menu" id="accountDropdownMenu">

                            <a href="Account.aspx">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                My Account
                            </a>

                            <div class="menu-divider"></div>

                            <asp:Panel
                                ID="pnlLogout"
                                runat="server"
                                Visible="false"
                                Style="display: block;">

                                <asp:LinkButton
                                    ID="btnLogout"
                                    runat="server"
                                    CssClass="logout-nav-button"
                                    OnClick="btnLogout_Click"
                                    OnClientClick="return confirmLogout();">

                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                                    Logout

                                </asp:LinkButton>

                            </asp:Panel>

                        </div>

                    </asp:Panel>


                </nav>


                <div class="nav-actions">

                    <a href="Contact.aspx"
                        class="btn btn-primary"
                        style="padding: 0.65rem 1.25rem; font-size: 0.725rem;">Inquire

                    </a>


                    <button
                        type="button"
                        class="mobile-nav-toggle"
                        id="mobile-menu-toggle"
                        aria-label="Open mobile menu">

                        <span></span>
                        <span></span>

                    </button>

                </div>

            </div>

        </header>


        <div style="min-height: 80vh; padding-top: var(--header-height);">

            <asp:ContentPlaceHolder
                ID="MainContent"
                runat="server">
            </asp:ContentPlaceHolder>

        </div>



        <footer>

            <div class="container">

                <div class="footer-grid">


                    <!-- FOOTER COLUMN 1 -->

                    <div class="footer-col">

                        <a href="Default.aspx"
                            class="logo">Real<span>Estate</span>

                        </a>

                        <p style="margin-top: 1rem;">
                            Quiet luxury real estate advisory presenting
                            curated international sanctuaries across unique
                            global destinations.

                        </p>

                    </div>


                    <!-- FOOTER COLUMN 2 -->

                    <div class="footer-col">

                        <h4>Navigation</h4>

                        <ul class="footer-links">

                            <li>
                                <a href="Default.aspx">Home
                                </a>
                            </li>

                            <li>
                                <a href="Properties.aspx">Residences
                                </a>
                            </li>

                            <li>
                                <a href="EMICalculator.aspx">EMI Calculator
                                </a>
                            </li>

                            <li>
                                <a href="Services.aspx">Advisory
                                </a>
                            </li>

                            <li>
                                <a href="About.aspx">About Us
                                </a>
                            </li>

                        </ul>

                    </div>


                    <!-- FOOTER COLUMN 3 -->

                    <div class="footer-col">

                        <h4>Portfolios</h4>

                        <ul class="footer-links">

                            <li>
                                <a href="Properties.aspx">Luxury Villas
                                </a>
                            </li>

                            <li>
                                <a href="Properties.aspx">Skyline Penthouses
                                </a>
                            </li>

                            <li>
                                <a href="Properties.aspx">Zen Townhouses
                                </a>
                            </li>

                        </ul>

                    </div>


                    <!-- FOOTER COLUMN 4 -->

                    <div class="footer-col">

                        <h4>Contact Desk</h4>

                        <p>
                            Connect with our senior advisory desk for
                            private off-market acquisitions.

                        </p>

                        <p style="margin-top: 1rem; color: var(--accent); font-weight: 600;">
                            advisory@realestate.luxury

                        </p>

                    </div>

                </div>


                <!-- FOOTER BOTTOM -->

                <div class="footer-bottom">

                    <p>
                        &copy; 2026 RealEstate Luxury LLC.
                        All rights reserved.
                    </p>

                    <p>
                        Tokyo &bull;
                        Paris &bull;
                        London &bull;
                        New York &bull;
                        Zurich &bull;
                        Sydney &bull;
                        Dubai
                    </p>

                </div>

            </div>

        </footer>

        <button
            type="button"
            class="back-to-top"
            id="back-to-top"
            aria-label="Scroll to top">

            <svg
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="2">

                <polyline points="18 15 12 9 6 15"></polyline>

            </svg>

        </button>


    </form>

    <script type="text/javascript">

        function confirmLogout() {

            return window.confirm(
                "Are you sure you want to logout?"
            );

        }

        (function () {
            var trigger = document.getElementById("accountTrigger");
            var menu = document.getElementById("accountDropdownMenu");

            if (!trigger || !menu) {
                return;
            }

            function closeMenu() {
                menu.classList.remove("open");
                trigger.setAttribute("aria-expanded", "false");
            }

            function toggleMenu(e) {
                e.stopPropagation();
                var isOpen = menu.classList.toggle("open");
                trigger.setAttribute("aria-expanded", isOpen ? "true" : "false");
            }

            trigger.addEventListener("click", toggleMenu);

            document.addEventListener("click", function (e) {
                if (!menu.contains(e.target) && e.target !== trigger) {
                    closeMenu();
                }
            });

            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape") {
                    closeMenu();
                }
            });
        })();

    </script>

    <script src='<%= ResolveUrl("~/js/script.js") %>'></script>

</body>

</html>