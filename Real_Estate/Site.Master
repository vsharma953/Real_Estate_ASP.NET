<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="Real_Estate.Site" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>realEstate International Architectural Residences</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' stroke='%23a3875a' stroke-width='2' fill='none'><path d='M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z'/><polyline points='9 22 9 12 15 12 15 22'/></svg>">
    <link rel="stylesheet" href="~/css/style.css" runat="server" />

    <asp:ContentPlaceHolder
        ID="HeadContent"
        runat="server">
    </asp:ContentPlaceHolder>

    <style>
        .logout-nav-button {
            background: none;
            border: none;
            padding: 0;
            margin: 0;
            color: inherit;
            font-family: inherit;
            font-size: inherit;
            font-weight: inherit;
            cursor: pointer;
        }

            .logout-nav-button:hover {
                color: var(--accent);
            }
    </style>

</head>

<body>

    <form id="form1" runat="server">
        <div class="page-loader" id="page-loader">
            <div class="loader-spinner"></div>
        </div>
        <header>

            <div class="container nav-container">

                <a href="Default.aspx"
                    class="logo">real<span>Estate</span>

                </a>

                <nav class="nav-menu"
                    id="nav-menu">

                    <a href="Default.aspx"
                        Cssclass="nav-link">Home

                    </a>

                    <a href="Properties.aspx"
                        class="nav-link">Residences

                    </a>
                    <a href="Services.aspx"
                        class="nav-link">Services

                    </a>


                    <a href="About.aspx"
                        class="nav-link">About Us

                    </a>

                    <a href="Contact.aspx"
                        class="nav-link">Contact Us

                    </a>

                    <asp:Panel
                        ID="pnlRegister"
                        runat="server"
                        CssClass="nav-item"
                        Style="display: inline;">

                        <a href="LoginRegister.aspx"
                            class="nav-link">Register

                        </a>

                    </asp:Panel>

                    <asp:Panel
                        ID="pnlAccount"
                        runat="server"
                        CssClass="nav-item"
                        Visible="false"
                        Style="display: inline;">

                        <a href="Account.aspx"
                            class="nav-link">Account

                        </a>

                    </asp:Panel>

                    <asp:Panel
                        ID="pnlLogout"
                        runat="server"
                        CssClass="nav-item"
                        Visible="false"
                        Style="display: inline;">

                        <asp:LinkButton
                            ID="btnLogout"
                            runat="server"
                            CssClass="nav-link logout-nav-button"
                            OnClick="btnLogout_Click"
                            OnClientClick="return confirmLogout();">

                            Logout

                        </asp:LinkButton>

                    </asp:Panel>


                </nav>


                <div class="nav-actions">

                    <a href="Contact.aspx"
                        class="btn btn-primary"
                        style="padding: 0.65rem 1.25rem; font-size: 0.725rem;">Inquire

                    </a>


                    <button
                        type="button"
                        class="mobile-nav-toggle"
                        id="mobile-menu-toggle"
                        aria-label="Open mobile menu">

                        <span></span>
                        <span></span>

                    </button>

                </div>

            </div>

        </header>


        <div style="min-height: 80vh; padding-top: var(--header-height);">

            <asp:ContentPlaceHolder
                ID="MainContent"
                runat="server">
            </asp:ContentPlaceHolder>

        </div>



        <footer>

            <div class="container">

                <div class="footer-grid">


                    <!-- FOOTER COLUMN 1 -->

                    <div class="footer-col">

                        <a href="Default.aspx"
                            class="logo">Real<span>Estate</span>

                        </a>

                        <p style="margin-top: 1rem;">
                            Quiet luxury real estate advisory presenting
                            curated international sanctuaries across unique
                            global destinations.

                        </p>

                    </div>


                    <!-- FOOTER COLUMN 2 -->

                    <div class="footer-col">

                        <h4>Navigation</h4>

                        <ul class="footer-links">

                            <li>
                                <a href="Default.aspx">Home
                                </a>
                            </li>

                            <li>
                                <a href="Properties.aspx">Residences
                                </a>
                            </li>

                            <li>
                                <a href="Services.aspx">Advisory
                                </a>
                            </li>

                            <li>
                                <a href="About.aspx">About Us
                                </a>
                            </li>

                        </ul>

                    </div>


                    <!-- FOOTER COLUMN 3 -->

                    <div class="footer-col">

                        <h4>Portfolios</h4>

                        <ul class="footer-links">

                            <li>
                                <a href="Properties.aspx">Luxury Villas
                                </a>
                            </li>

                            <li>
                                <a href="Properties.aspx">Skyline Penthouses
                                </a>
                            </li>

                            <li>
                                <a href="Properties.aspx">Zen Townhouses
                                </a>
                            </li>

                        </ul>

                    </div>


                    <!-- FOOTER COLUMN 4 -->

                    <div class="footer-col">

                        <h4>Contact Desk</h4>

                        <p>
                            Connect with our senior advisory desk for
                            private off-market acquisitions.

                        </p>

                        <p style="margin-top: 1rem; color: var(--accent); font-weight: 600;">
                            advisory@realestate.luxury

                        </p>

                    </div>

                </div>


                <!-- FOOTER BOTTOM -->

                <div class="footer-bottom">

                    <p>
                        &copy; 2026 RealEstate Luxury LLC.
                        All rights reserved.
                    </p>

                    <p>
                        Tokyo &bull;
                        Paris &bull;
                        London &bull;
                        New York &bull;
                        Zurich &bull;
                        Sydney &bull;
                        Dubai
                    </p>

                </div>

            </div>

        </footer>

        <button
            type="button"
            class="back-to-top"
            id="back-to-top"
            aria-label="Scroll to top">

            <svg
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="2">

                <polyline points="18 15 12 9 6 15"></polyline>

            </svg>

        </button>


    </form>

    <script type="text/javascript">

        function confirmLogout() {

            return window.confirm(
                "Are you sure you want to logout?"
            );

        }
    </script>

    <script src='<%= ResolveUrl("~/js/script.js") %>'></script>

</body>

</html>
