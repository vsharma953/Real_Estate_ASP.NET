<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.master.cs" Inherits="Real_Estate.Admin.Admin" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agent Desk | realEstate</title>
    <link href="css/admin-style.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server" style="display: flex; width: 100%;">

        <aside class="admin-sidebar">
            <div class="admin-brand">
                real<span>Estate</span>
            </div>
            <nav class="admin-nav">
                <a href="Dashboard.aspx">Dashboard</a>
                <a href="ManageProperties.aspx">Properties</a>
                <a href="ClientDirectory.aspx">Client Directory</a>
                <%--<a href="ValuationRequests.aspx">Valuation Requests</a>--%>
                <a href="Settings.aspx">Settings</a>
            </nav>
            <div class="admin-footer">
                &copy; 2026 Advisory Desk<br />
                Logged in securely.
            </div>
        </aside>

        <main class="admin-main">
            <header class="admin-header">
                <h2>
                    <asp:Literal ID="litPageTitle" runat="server" Text="Agent Dashboard"></asp:Literal></h2>
                <div class="agent-profile">
                    <span><asp:Literal ID="litAgentName" runat="server" Text="Agent"></asp:Literal></span>
                    <div class="agent-avatar"><asp:Literal ID="litAgentInitials" runat="server" Text="A"></asp:Literal></div>
                </div>
            </header>

            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>

    </form>
</body>
</html>